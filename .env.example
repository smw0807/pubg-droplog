NUXT_DATA_MODE=demo
NUXT_PUBG_API_KEY=
# false: cache in server memory (default). true: persist to PostgreSQL.
NUXT_DB_ENABLED=false
# Public origin for canonical and social previews, e.g. https://your-domain.com.
# Leave empty locally to use the current request origin.
NUXT_PUBLIC_SITE_URL=
# Used by the app only when NUXT_DB_ENABLED=true.
# Live validation also requires NUXT_DB_ENABLED=true; migrations use this URL directly.
# Local Docker Compose only; replace for any non-local environment.
NUXT_DATABASE_URL=postgres://droplog:local_demo_only@127.0.0.1:55432/droplog
